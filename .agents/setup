#!/usr/bin/env bash
# Orb setup for Clyde: Go, JDK, Paper gym server, body and gym agent dependencies.
# Idempotent; safe to re-run. Tools go under ~/tools, the gym server under ~/paper.
set -euo pipefail

GO_VERSION=1.27.2
JDK_MAJOR=25

TOOLS="$HOME/tools"
mkdir -p "$TOOLS"

if [ ! -x "$TOOLS/go/bin/go" ] || ! "$TOOLS/go/bin/go" version | grep -q "go$GO_VERSION"; then
  echo "Installing Go $GO_VERSION"
  rm -rf "$TOOLS/go"
  curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -xz -C "$TOOLS"
fi

if [ ! -x "$TOOLS/jdk/bin/java" ]; then
  echo "Installing Temurin JDK $JDK_MAJOR"
  tmp=$(mktemp -d)
  curl -fsSL "https://api.adoptium.net/v3/binary/latest/${JDK_MAJOR}/ga/linux/x64/jdk/hotspot/normal/eclipse" | tar -xz -C "$tmp"
  rm -rf "$TOOLS/jdk"
  mv "$tmp"/jdk-* "$TOOLS/jdk"
  rm -rf "$tmp"
fi

export PATH="$TOOLS/go/bin:$TOOLS/jdk/bin:$PATH"
if ! grep -q 'tools/go/bin' "$HOME/.bashrc" 2>/dev/null; then
  echo 'export PATH="$HOME/tools/go/bin:$HOME/tools/jdk/bin:$PATH"' >> "$HOME/.bashrc"
fi

# Downloads Paper and re-renders ~/paper/server.properties from
# gym/server.properties on every run, so the two never drift.
"$(dirname "$0")/../gym/bin/paper" install

if [ -f "$(dirname "$0")/../body/package-lock.json" ]; then
  (cd "$(dirname "$0")/../body" && npm ci --no-audit --no-fund)
fi

(cd "$(dirname "$0")/../gym/agents" && npm ci --no-audit --no-fund)

if [ -f "$(dirname "$0")/../harness/go.mod" ]; then
  (cd "$(dirname "$0")/../harness" && go mod download)
fi

echo "Setup complete. Start the gym server with: gym/bin/paper start"
