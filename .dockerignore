# Allowlist: secrets, memory, worlds, logs, Git and local modules never enter context.
**
!body/
body/*
!body/package.json
!body/package-lock.json
!body/tsconfig.json
!body/src/
!body/src/**
!harness/
!harness/**
!api/
api/*
!api/*.schema.json
!prompts/
!prompts/**
!skills/
skills/*
!skills/README.md
!skills/collect-logs/
!skills/craft-item/
!skills/craft-place-table/
!skills/deposit-items/
!skills/eat-food/
skills/*/*
!skills/*/skill.md
!skills/*/index.js
!skills/*/test.yaml
!deploy/
deploy/*
!deploy/Dockerfile
!deploy/entrypoint
!deploy/admissions/
deploy/admissions/*
!deploy/admissions/collect-logs/
!deploy/admissions/craft-item/
!deploy/admissions/craft-place-table/
!deploy/admissions/deposit-items/
!deploy/admissions/eat-food/
deploy/admissions/*/*
!deploy/admissions/revision.txt
!deploy/admissions/*/.admission.json
# Also exclude private files accidentally put under an allowed source tree.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.log
**/node_modules
**/*.db
**/*.db-wal
**/*.db-shm
